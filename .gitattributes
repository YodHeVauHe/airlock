# Normalize line endings. The deploy scripts and YAML must stay LF — they run on Linux.
* text=auto eol=lf

*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.js text eol=lf
*.html text eol=lf
*.csv text eol=lf
*.json text eol=lf
Dockerfile text eol=lf

# Windows metadata
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binaries
*.png binary
*.jpg binary
*.ico binary
*.db binary
