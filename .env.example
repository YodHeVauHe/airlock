# ---- Airlock control plane ----
# Vultr Serverless Inference (OpenAI-compatible). Required for live agent mode.
# Get a key: provision Serverless Inference in the Vultr console, see
# https://docs.vultr.com/products/serverless/inference/provisioning
AIRLOCK_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
AIRLOCK_INFERENCE_API_KEY=
AIRLOCK_INFERENCE_MODEL=

# Set to 1 to run fully offline with the deterministic mock planner (dev/CI).
AIRLOCK_MOCK_LLM=1

# Sandbox driver: local (dev machine, subprocess) | docker (production, Vultr VM)
AIRLOCK_DRIVER=local

# Policy: enforce (block hostile generated code pre-execution) | monitor (record only)
AIRLOCK_POLICY_MODE=enforce

# Sandbox resource caps
AIRLOCK_TIMEOUT_S=60
AIRLOCK_MEM_MB=512
AIRLOCK_CPUS=1.0
AIRLOCK_PIDS=128

# Public URL of this deployment (used by the throwaway-instance driver callbacks)
AIRLOCK_PUBLIC_URL=

# ---- throwaway-instance driver (experimental) ----
# Same Vultr API key; used ONLY by the control plane to create/destroy instances.
VULTR_API_KEY=
AIRLOCK_VULTR_DRIVER=0
AIRLOCK_VULTR_REGION=ewr
AIRLOCK_VULTR_PLAN=vc2-1-1
